#!/bin/bash
# Dotfiles installer
# Usage: ./setup [OPTIONS] [module ...]
#
# Two modes:
#   sync   (default)  install/update configs only
#   fresh  (--fresh)  wipe existing configs and reinstall the program from scratch
set -eo pipefail

DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export DOTFILES_DIR

# shellcheck source=lib/helpers.sh
source "$DOTFILES_DIR/lib/helpers.sh"
# shellcheck source=lib/modules.sh
source "$DOTFILES_DIR/lib/modules.sh"

# ════════════════════════════════════════════
# Error handling
# ════════════════════════════════════════════

cleanup() {
  local exit_code=$?
  if [[ $exit_code -ne 0 ]]; then
    log_error "Setup failed (exit code $exit_code)"
  fi
}
trap cleanup EXIT

# ════════════════════════════════════════════
# Usage
# ════════════════════════════════════════════

usage() {
  cat <<EOF
${BOLD}Dotfiles installer${NC}

Usage: $(basename "$0") [OPTIONS] [module ...]

${BOLD}Modes:${NC}
  sync   (default)  install or update configs (idempotent symlinks)
  fresh  --fresh    remove existing configs, uninstall + reinstall the program,
                    then install configs from scratch

${BOLD}Options:${NC}
  -m, --module <name>   Install a specific module (repeatable)
  -a, --all             Install all modules
      --core            Install core modules only (homebrew, zsh, git)
  -F, --fresh           Fresh install: wipe configs and reinstall programs
  -n, --dry-run         Show what would happen without making changes
  -v, --verbose         Verbose output
  -f, --force           Overwrite without backup
  -c, --copy            Copy files instead of symlinking (for disposable clones)
  -h, --help            Show this help message

${BOLD}Examples:${NC}
  $(basename "$0")                        # show this help
  $(basename "$0") --all                  # sync everything (default)
  $(basename "$0") --all --fresh          # wipe and reinstall everything
  $(basename "$0") claude                 # sync only Claude Code config
  $(basename "$0") claude --fresh         # nuke and reinstall Claude Code
  $(basename "$0") zsh vscode             # sync multiple modules
  $(basename "$0") --dry-run --all --fresh  # preview a fresh install

EOF
  list_modules
}

# ════════════════════════════════════════════
# Parse arguments
# ════════════════════════════════════════════

MODULES=()
MODE=""

while [[ $# -gt 0 ]]; do
  case $1 in
    -m|--module)
      if [[ -z "${2:-}" ]]; then
        log_error "--module requires a module name"
        exit 1
      fi
      MODULES+=("$2")
      MODE="specific"
      shift 2
      ;;
    -a|--all)
      MODE="all"
      shift
      ;;
    --core)
      MODE="core"
      shift
      ;;
    -F|--fresh)
      FRESH="true"
      shift
      ;;
    -n|--dry-run)
      DRY_RUN="true"
      shift
      ;;
    -v|--verbose)
      VERBOSE="true"
      shift
      ;;
    -f|--force)
      FORCE="true"
      shift
      ;;
    -c|--copy)
      COPY_MODE="true"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    -*)
      log_error "Unknown option: $1"
      echo "Use --help for usage information"
      exit 1
      ;;
    *)
      MODULES+=("$1")
      MODE="specific"
      shift
      ;;
  esac
done

if [[ -z "$MODE" ]]; then
  usage
  exit 0
fi

# ════════════════════════════════════════════
# Preflight checks
# ════════════════════════════════════════════

preflight() {
  verbose "Running preflight checks..."

  local os
  os="$(uname -s)"
  if [[ "$os" != "Darwin" ]] && [[ "$os" != "Linux" ]]; then
    log_error "Unsupported OS: $os"
    exit 1
  fi
  verbose "OS: $os"

  for tool in git curl; do
    if ! command -v "$tool" &>/dev/null; then
      log_error "Required tool not found: $tool"
      exit 1
    fi
  done
  verbose "Required tools: OK"
}

preflight

# ════════════════════════════════════════════
# Resolve and validate modules
# ════════════════════════════════════════════

if [[ "$MODE" == "specific" ]]; then
  resolve_modules specific "${MODULES[@]}"
else
  resolve_modules "$MODE"
fi

for mod in "${RESOLVED_MODULES[@]}"; do
  validate_module "$mod"
done

# ════════════════════════════════════════════
# Fresh-mode confirmation
# ════════════════════════════════════════════

if is_fresh && [[ "$DRY_RUN" != "true" ]]; then
  log_header "Fresh Install"
  log_warn "Fresh mode will:"
  echo "  • Remove existing configs/symlinks for: ${RESOLVED_MODULES[*]}"
  if is_macos; then
    echo "  • Uninstall and reinstall associated programs (brew/npm packages)"
  else
    echo "  • Uninstall and reinstall associated programs (pacman/npm packages)"
  fi
  echo "  • Reset plugins, marketplaces, and editor settings"
  echo ""
  log_warn "Backups go to: $BACKUP_DIR"
  echo ""
  if [[ -t 0 ]]; then
    read -rp "Continue? (yes/no) " confirm
    if [[ "$confirm" != "yes" ]]; then
      log_info "Aborted by user"
      exit 0
    fi
  else
    log_warn "Non-interactive shell — proceeding without confirmation"
  fi
fi

# ════════════════════════════════════════════
# Create common directories
# ════════════════════════════════════════════

if ! dry_run "Would create ~/.config and ~/workspace"; then
  mkdir -p "$HOME/.config"
  mkdir -p "$HOME/workspace"
fi

# ════════════════════════════════════════════
# Export environment for module scripts
# ════════════════════════════════════════════

export DOTFILES_DIR DRY_RUN VERBOSE FORCE COPY_MODE FRESH BACKUP_DIR

# ════════════════════════════════════════════
# Install modules
# ════════════════════════════════════════════

mode_label="sync"
is_fresh && mode_label="fresh"
log_info "Mode: $mode_label — installing: ${RESOLVED_MODULES[*]}"
if [[ "$DRY_RUN" == "true" ]]; then
  log_warn "Dry-run mode — no changes will be made"
fi
echo ""

failed_modules=()

for mod in "${RESOLVED_MODULES[@]}"; do
  if bash "$DOTFILES_DIR/$mod/install.sh"; then
    verbose "Module '$mod' completed"
  else
    log_error "Module '$mod' failed"
    failed_modules+=("$mod")
  fi
done

# ════════════════════════════════════════════
# Summary
# ════════════════════════════════════════════

echo ""
if [[ ${#failed_modules[@]} -gt 0 ]]; then
  log_error "Failed modules: ${failed_modules[*]}"
  exit 1
else
  log_ok "All modules installed successfully"
fi

if [[ "$DRY_RUN" != "true" ]]; then
  echo ""
  log_info "Next steps:"
  echo "  1. Restart your shell: exec zsh"
  echo "  2. Open your editor and verify settings"
  if is_fresh; then
    echo "  3. Restart Claude Code if you used --fresh on the claude module"
  fi
fi
