{
  "permissions": {
    "allow": [
      "Bash(*load_handover*)",
      "Bash(*clear_last_handover*)",
      "Bash(*clear_handovers*)",
      "Bash(mkdir*handover*)",
      "Write(*/.claude/handovers/*.md)",
      "Edit(*/.claude/handovers/*.md)",
      "mcp__codegraph__codegraph_search",
      "mcp__codegraph__codegraph_context",
      "mcp__codegraph__codegraph_callers",
      "mcp__codegraph__codegraph_callees",
      "mcp__codegraph__codegraph_impact",
      "mcp__codegraph__codegraph_node",
      "mcp__codegraph__codegraph_status"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "codegraph mark-dirty",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "codegraph sync-if-dirty"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "claude-powerline --theme=rose-pine --style=powerline"
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": false,
    "superpowers@claude-plugins-official": true,
    "obsidian@obsidian-skills": true,
    "quiver@quiver": true
  },
  "extraKnownMarketplaces": {
    "obsidian-skills": {
      "source": {
        "source": "github",
        "repo": "kepano/obsidian-skills"
      }
    },
    "quiver": {
      "source": {
        "source": "github",
        "repo": "yagizdo/quiver"
      }
    },
    "every-marketplace": {
      "source": {
        "source": "git",
        "url": "https://github.com/kieranklaassen/compound-engineering-plugin.git"
      }
    },
    "xclaude-plugin-marketplace": {
      "source": {
        "source": "github",
        "repo": "conorluddy/xclaude-plugin"
      }
    },
    "ui-ux-pro-max-skill": {
      "source": {
        "source": "github",
        "repo": "nextlevelbuilder/ui-ux-pro-max-skill"
      }
    }
  },
  "language": "Turkish",
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "theme": "dark-ansi",
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true,
  "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
  "model": "Opus"
}
