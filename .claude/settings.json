{
  "permissions": {
    "allow": [
      "Bash(*load_handover*)",
      "Bash(*clear_last_handover*)",
      "Bash(*clear_handovers*)",
      "Bash(mkdir*handover*)",
      "Write(*/.claude/handovers/*.md)",
      "Edit(*/.claude/handovers/*.md)"
    ],
    "defaultMode": "plan"
  },
  "statusLine": {
    "type": "command",
    "command": "npx -y @owloops/claude-powerline@latest --theme=rose-pine --style=powerline"
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "compound-engineering@every-marketplace": true,
    "swift-lsp@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "xclaude-plugin@xclaude-plugin-marketplace": true,
    "obsidian@obsidian-skills": true,
    "ui-ux-pro-max@ui-ux-pro-max-skill": true
  },
  "extraKnownMarketplaces": {
    "obsidian-skills": {
      "source": {
        "source": "github",
        "repo": "kepano/obsidian-skills"
      }
    },
    "ui-ux-pro-max-skill": {
      "source": {
        "source": "github",
        "repo": "nextlevelbuilder/ui-ux-pro-max-skill"
      }
    }
  },
  "effortLevel": "medium"
}
