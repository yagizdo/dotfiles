# Config syntax crash course
# ==========================
# # The config file consists of simple key-value pairs,
# # separated by equals signs.
# font-family = Iosevka
# window-padding-x = 2
#
# # Spacing around the equals sign does not matter.
# # All of these are identical:
# key=value
# key= value
# key =value
# key = value
#
# # Any line beginning with a # is a comment. It's not possible to put
# # a comment after a config option, since it would be interpreted as a
# # part of the value. For example, this will have a value of "#123abc":
# background = #123abc
#
# # Empty values are used to reset config keys to default.
# key =
#
# # Some config options have unique syntaxes for their value,
# # which is explained in the docs for that config option.
# # Just for example:
# resize-overlay-duration = 4s 200ms

mouse-scroll-multiplier = 0.5

window-decoration = true
window-padding-x = 8
window-padding-y = 8

theme = Catppuccin Macchiato
font-feature = -liga

macos-titlebar-style = transparent

# ============================================================
# YÖNTEM 1: key-remap (önerilen, en temiz çözüm)
# macOS'taki Ctrl↔Command swap'ını Ghostty içinde geri alır.
# Böylece fiziksel Ctrl = Ctrl olarak terminal'e ulaşır.
# Tüm Ctrl kısayolları otomatik çalışır, tek tek tanımlamaya gerek yok.
# ============================================================
key-remap = ctrl=super
key-remap = super=ctrl

# ============================================================
# YÖNTEM 2: text action ile manuel mapping (alternatif)
# Belirli cmd+key kombinasyonlarını Ctrl karşılığına map eder.
# Yöntem 1'i kullanıyorsan bunları YORUM SATIRINDA BIRAK.
# Yöntem 2'yi denemek istersen Yöntem 1'i yorum yap, bunları aç.
# ============================================================
# keybind = cmd+g=text:\x07
# keybind = cmd+p=text:\x10
# keybind = cmd+t=text:\x14
# keybind = cmd+n=text:\x0e
# keybind = cmd+h=text:\x08
# keybind = cmd+s=text:\x13
# keybind = cmd+o=text:\x0f
# keybind = cmd+q=text:\x11
# keybind = cmd+b=text:\x02
# keybind = cmd+c=text:\x03
# keybind = cmd+f=text:\x06

# Copy/Paste with physical Ctrl
keybind = ctrl+c=copy_to_clipboard:mixed
keybind = ctrl+v=paste_from_clipboard

# Unbind CMD+... keys so they will be forwarded to Zellij
keybind = cmd+t=unbind
keybind = cmd+n=unbind
keybind = cmd+c=unbind
keybind = cmd+w=unbind
keybind = cmd+opt+left=unbind
keybind = cmd+opt+right=unbind
