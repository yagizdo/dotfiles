shell-integration = fish
command = /opt/homebrew/bin/zellij

mouse-scroll-multiplier = 0.5

window-decoration = true
window-width = 176
window-height = 47
window-padding-x = 8
window-padding-y = 8

theme = Catppuccin Macchiato
font-feature = -liga

macos-titlebar-style = transparent

# macOS remap: Physical Ctrl → Cmd, Physical Command → Ctrl
# So "cmd+" keybinds = Physical Ctrl key

# Copy/paste (Physical Ctrl+C/V)
keybind = cmd+c=copy_to_clipboard
keybind = cmd+v=paste_from_clipboard

# Zellij mode shortcuts (Physical Ctrl+key → send Ctrl char to terminal)
keybind = cmd+g=text:\x07
keybind = cmd+t=text:\x14
keybind = cmd+p=text:\x10
keybind = cmd+n=text:\x0e
keybind = cmd+s=text:\x13
keybind = cmd+o=text:\x0f
keybind = cmd+h=text:\x08
keybind = cmd+b=text:\x02
keybind = cmd+w=text:\x17
keybind = cmd+opt+left=unbind
keybind = cmd+opt+right=unbind

# Ctrl+Arrow for Zellij (Physical Ctrl = cmd in macOS)
keybind = cmd+left=text:\x1b[1;5D
keybind = cmd+right=text:\x1b[1;5C
keybind = cmd+up=text:\x1b[1;5A
keybind = cmd+down=text:\x1b[1;5B
