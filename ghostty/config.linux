shell-integration = fish
command = zellij

mouse-scroll-multiplier = 0.5

window-decoration = true
window-width = 176
window-height = 47
window-padding-x = 8
window-padding-y = 8

theme = Catppuccin Macchiato
font-feature = -liga

# Zellij mode shortcuts (Ctrl+key → send Ctrl char to terminal)
keybind = ctrl+g=text:\x07
keybind = ctrl+t=text:\x14
keybind = ctrl+p=text:\x10
keybind = ctrl+n=text:\x0e
keybind = ctrl+s=text:\x13
keybind = ctrl+o=text:\x0f
keybind = ctrl+h=text:\x08
keybind = ctrl+b=text:\x02
keybind = ctrl+w=text:\x17

# Ctrl+Arrow for Zellij pane navigation
keybind = ctrl+left=text:\x1b[1;5D
keybind = ctrl+right=text:\x1b[1;5C
keybind = ctrl+up=text:\x1b[1;5A
keybind = ctrl+down=text:\x1b[1;5B
