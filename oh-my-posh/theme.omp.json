{
  "version": 2,
  "final_space": true,
  "palette": {
    "red": "#ED8796",
    "peach": "#F5A97F",
    "yellow": "#EED49F",
    "green": "#A6DA95",
    "teal": "#8BD5CA",
    "sky": "#91D7E3",
    "sapphire": "#7DC4E4",
    "blue": "#8AADF4",
    "mauve": "#C6A0F6",
    "lavender": "#B7BDF8",
    "text": "#CAD3F5",
    "subtext0": "#A5ADCB",
    "overlay": "#939AB7",
    "surface": "#494D64"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "os",
          "style": "plain",
          "foreground": "p:overlay",
          "template": " ╭─<p:surface>[</>{{.Icon}} "
        },
        {
          "type": "session",
          "style": "plain",
          "foreground": "p:blue",
          "template": "{{ if .SSHSession }}󰌘 {{ end }}{{ .UserName }}@{{ .HostName }}<p:surface>]</> "
        },
        {
          "type": "path",
          "style": "plain",
          "foreground": "p:mauve",
          "properties": {
            "folder_icon": "",
            "folder_separator_icon": " / ",
            "home_icon": "󰋜",
            "max_depth": 2,
            "style": "agnoster_short"
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "git",
          "style": "plain",
          "foreground": "p:lavender",
          "template": "{{ .UpstreamIcon }}{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }}  {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }}  {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }} 󰆓 {{ .StashCount }}{{ end }}",
          "properties": {
            "branch_icon": " ",
            "fetch_stash_count": true,
            "fetch_status": true,
            "fetch_upstream_icon": true,
            "fetch_worktree_count": true
          }
        },
        {
          "type": "time",
          "style": "plain",
          "foreground": "p:teal",
          "template": " {{ .CurrentDate | date .Format }} ",
          "properties": {
            "time_format": "Mon | 15:04"
          }
        },
        {
          "type": "battery",
          "style": "plain",
          "foreground": "p:peach",
          "foreground_templates": [
            "{{if eq \"Charging\" .State.String }}p:green{{end}}"
          ],
          "template": " {{ .Percentage}}% {{ .Icon }}",
          "properties": {
            "charged_icon": "󰂄",
            "charging_icon": "󰂄",
            "discharging_icon": "󰁹"
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:overlay",
          "template": " ╰─ 󰅂 "
        }
      ]
    }
  ]
}
